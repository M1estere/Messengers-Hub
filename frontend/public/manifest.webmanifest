{
  "name": "Messengers Hub",
  "short_name": "Hub",
  "description": "Единый интерфейс сообщений Telegram и MAX",
  "start_url": "/connect-hub/",
  "scope": "/connect-hub/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#17191d",
  "theme_color": "#24272d",
  "icons": [
    { "src": "/connect-hub/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/connect-hub/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/connect-hub/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
