YOUGILE_TASK_TEXT=Пользователь: {name}\nUsername: {username}\nПлатформа: {platform}\nID чата: {external_id}\nID пользователя: {user_external_id}\nПрофиль: {profile_url}
VAPID_PRIVATE_KEY=/var/www/connect-hub/backend/vapid_private.pem
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@130-17-17-201.sslip.io
